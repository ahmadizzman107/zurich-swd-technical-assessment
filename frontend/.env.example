# Copy this file to .env and fill in real values. Never commit .env.

# Base URL of this app, used by NextAuth for callbacks
NEXTAUTH_URL=http://localhost:3000

# Random secret used to sign/encrypt NextAuth session tokens.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base URL of the backend API this app talks to. Must be NEXT_PUBLIC_-prefixed
# since it's read from client components and needs to reach the browser bundle.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
