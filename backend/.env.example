# Copy this file to .env and fill in real values. Never commit .env.

# Base URL of the reqres.in API this service proxies
REQRES_BASE_URL=https://reqres.in/api

# API key sent as the x-api-key header to reqres.in
REQRES_API_KEY=

# Reserved for reqres.in bearer auth; not currently read by the app
REQRES_AUTH_TOKEN=

# Must match the frontend's NEXTAUTH_SECRET — used to verify the JWT issued by NextAuth
NEXTAUTH_SECRET=

# Origin allowed by CORS; should match the frontend's NEXTAUTH_URL
FRONTEND_URL=http://localhost:3000

# Port this service listens on
PORT=4000
